        "jsCode": "// Where the card was posted, so a decision taken in the portal can update it later\nconst r = $input.first().json;\nconst ts = r.ts || (r.message && r.message.ts);\nconst channel = r.channel || (r.message && r.message.channel);\nif (!ts || !channel) return [];\nreturn [{ json: { ticket_ref: $('Build approval message').first().json.ticket_ref, channel, ts } }];"
