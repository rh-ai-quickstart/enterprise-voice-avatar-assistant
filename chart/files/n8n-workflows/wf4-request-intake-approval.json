    {
      "parameters": {
        "jsCode": "// Slack signs every request: HMAC-SHA256 of v0:<timestamp>:<raw body> with the app's signing secret.\n// Anything else posting here (the n8n Route is public) is refused before it can touch a ticket.\nconst crypto = require('crypto');\nconst item = $input.first();\nconst secret = $env.SLACK_SIGNING_SECRET || '';\nconst headers = item.json.headers || {};\nconst ts = headers['x-slack-request-timestamp'] || '';\nconst sig = headers['x-slack-signature'] || '';\nlet reason = '';\nif (!secret) reason = 'SLACK_SIGNING_SECRET is not set';\nelse if (!ts || !sig) reason = 'the request carries no Slack signature';\nelse if (Math.abs(Date.now() / 1000 - Number(ts)) > 300) reason = 'the Slack timestamp is more than five minutes off';\nelse {\n  const raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n  const expected = 'v0=' + crypto.createHmac('sha256', secret).update(`v0:${ts}:${raw}`).digest('hex');\n  if (expected.length !== sig.length || !crypto.timingSafeEqual(Buffer.from(expected), Buffer.from(sig))) {\n    reason = 'the Slack signature does not match';\n  }\n}\nreturn [{ json: { body: item.json.body, signature_ok: !reason, reason } }];"
      },
      "id": "227477d6-2dda-51d6-ad7d-c01263b0e4de",
