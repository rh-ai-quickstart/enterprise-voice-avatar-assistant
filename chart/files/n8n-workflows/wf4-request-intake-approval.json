    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.body && $input.first().json.body.payload;\nconst p = typeof raw === 'string' ? JSON.parse(raw) : (raw || {});\nconst a = (p.actions && p.actions[0]) || {};\nconst decision = a.action_id === 'approve_request' ? 'approved' : 'rejected';\nconst actor = (p.user && (p.user.username || p.user.name)) || 'slack';\nreturn [{ json: {\n  ticket_ref: a.value, decision, actor,\n  user_id: (p.user && p.user.id) || '',\n  channel: (p.channel && p.channel.id) || (p.container && p.container.channel_id) || '',\n  ts: (p.container && p.container.message_ts) || (p.message && p.message.ts) || '',\n} }];"
      },
