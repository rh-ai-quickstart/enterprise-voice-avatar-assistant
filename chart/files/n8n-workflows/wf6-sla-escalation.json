    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.RAG_API_URL }}/v1/internal/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ kind: 'integration.error', severity: 'error', ref_type: 'integration', ref_id: 'slack', title: 'Slack: Notify escalation failed', detail: String(($json.error && $json.error.message) || $json.error || 'Slack answered not ok').slice(0, 1000) }) }}"
      },
      "id": "e2407b66-6737-5fb0-a44a-8702ba3aa910",
      "name": "Report Slack failure (Notify escalation)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1820,
        -20
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst items = $input.first().json;\nconst remind = items.remind || [];\nif (remind.length === 0) return [];\nconst lines = remind.map(t => `• *${t.ticket_ref}* ${esc(t.title)} — ${Math.round(t.pending_minutes)}m pending (${t.priority}, requester: ${esc(t.requester || '-')})`);\nconst text = `:hourglass_flowing_sand: *Approval reminder* — ${remind.length} ticket(s) awaiting approval:\\n${lines.join('\\n')}`;\nreturn [{ json: { text } }];"
      },
      "id": "a1b2c3d4-1111-5555-aaaa-000000000007",
      "name": "Build reminder message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const remind = $('Check for stale tickets').first().json.remind || [];\nreturn remind.map((t) => ({ json: { ticket_ref: t.ticket_ref, title: t.title, priority: t.priority, minutes: Math.round(t.pending_minutes) } }));"
      },
