      "parameters": {
        "jsCode": "// The RAG API already created the Google Doc (service account) and sent its link along.\nconst body = $('Archive transcript').first().json.body || {};\nconst sid = body.session_id;\nconst transcript = $input.first().json.transcript || '';\nconst date = new Date().toISOString().slice(0, 16).replace('T', ' ');\nreturn [{ json: { session_id: sid, title: body.title || `Assistant transcript ${sid.slice(0, 8)} ${date}`, transcript: `# Assistant transcript ${sid}\\n\\n${transcript}`, doc_url: body.doc_url || '' } }];"
      },
      "id": "9ec06b11-8a8b-5b79-b002-c0a50f1a7551",
      "name": "Prepare document",
