            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $json.body.message, session_id: $json.body.session_id, user_id: $json.body.user_id, mode: $json.body.mode || 'text' }) }}"
      },
      "id": "97eae338-86b9-50f1-b7f4-40bf63406e9c",
      "name": "Ask the RAG API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "b40fe025-ccd4-54a7-9180-ea83f5c97277",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        520,
        0
      ]
    }
  ],
  "connections": {
    "Chat webhook": {
      "main": [
        [
          {
            "node": "Ask the RAG API",
            "type": "main",
            "index": 0
