    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst key = $('Classify webhook').first().json.body.key;\nconst fields = JSON.stringify(r.fields || {}, null, 2);\nconst text = `:page_facing_up: *${key}* classified as *${r.doc_type}* (confidence ${Math.round((r.confidence || 0) * 100)}%)\\n${r.summary || ''}\\n\\`\\`\\`${fields.slice(0, 2500)}\\`\\`\\``;\nreturn [{ json: { key, doc_type: r.doc_type, confidence: r.confidence, summary: r.summary, fields: r.fields, doc_id: r.doc_id, text } }];"
      },
      "id": "fc6d24d4-711d-545b-b303-1a8cdd25c5fb",
      "name": "Format result",
