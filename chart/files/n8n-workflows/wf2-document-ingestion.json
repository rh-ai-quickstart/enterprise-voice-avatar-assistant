    {
      "parameters": {
        "jsCode": "// S3 bucket notifications from the object store (VersityGW): AWS-style Records. VersityGW sends\n// the object key as it is; set S3_EVENT_KEYS_ENCODED=true for a store that URL-encodes it (AWS S3).\n// Only the buckets in EVENT_BUCKETS go on: transcripts are indexed by the archival workflow itself.\nconst body = $input.first().json.body || $input.first().json;\nconst buckets = String($env.EVENT_BUCKETS || 'documents,inbox').split(',').map((b) => b.trim()).filter(Boolean);\nconst encoded = String($env.S3_EVENT_KEYS_ENCODED || '').toLowerCase() === 'true';\nconst decode = (key) => { try { return decodeURIComponent(key.replace(/\\+/g, ' ')); } catch (e) { return key; } };\nconst out = [];\nfor (const r of body.Records || []) {\n  const bucket = r.s3 && r.s3.bucket && r.s3.bucket.name;\n  const rawKey = (r.s3 && r.s3.object && r.s3.object.key) || '';\n  const key = encoded ? decode(rawKey) : rawKey;\n  const event = r.eventName || '';\n  if (bucket && key && buckets.includes(bucket)) out.push({ json: { bucket, key, event, created: event.includes('ObjectCreated') } });\n}\nreturn out;"
      },
