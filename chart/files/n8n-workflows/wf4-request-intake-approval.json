    {
      "parameters": {
        "jsCode": "const icons = { approved: ':white_check_mark:', rejected: ':x:', cancelled: ':no_entry_sign:' };\n// The card as it was posted, without its buttons, with the outcome underneath\nconst cardFor = (t, status, via, by, note, fulfilled) => {\n  const p = t.payload || {};\n  const word = status.charAt(0).toUpperCase() + status.slice(1);\n  const rest = `${via === 'portal' ? ' in the portal' : ''}${by ? ' by ' + by : ''}${fulfilled ? ' and fulfilled' : ''}${status === 'rejected' && note ? ': ' + note : ''}`;\n  const blocks = [\n    { type: 'header', text: { type: 'plain_text', text: `Service request ${t.ticket_ref}` } },\n    { type: 'section', text: { type: 'mrkdwn', text: `*${t.title}*\\n${p.summary || t.description || ''}` } },\n    { type: 'section', fields: [\n      { type: 'mrkdwn', text: `*Category*\\n${t.category || '-'}` },\n      { type: 'mrkdwn', text: `*Priority*\\n${t.priority || '-'}` },\n      { type: 'mrkdwn', text: `*Requester*\\n${t.requester || '-'}` },\n      { type: 'mrkdwn', text: `*Channel*\\n${p.channel || '-'}` } ] },\n    { type: 'context', elements: [{ type: 'mrkdwn', text: `${icons[status] || ':information_source:'} *${word}*${rest}` }] },\n  ];\n  return { card_text: `Service request ${t.ticket_ref}: ${word}${rest}`, card_blocks: blocks };\n};\n// One shape for a decision, whether it was a Slack click (after Record decision) or the admin\n// portal (the ticket-decided webhook): the branch below fulfils, notifies and updates the card.\nconst input = $input.first().json;\nlet t, decision, actor, via, note, channel, ts;\nif (input.body && input.body.via === 'portal') {\n  ({ ticket: t, decision, actor, note } = input.body);\n  via = 'portal';\n  const slack = (t.payload && t.payload.slack) || {};\n  channel = slack.channel || '';\n  ts = slack.ts || '';\n} else {\n  const click = $('Parse Slack action').first().json;\n  t = input;\n  ({ decision, actor, channel, ts } = click);\n  via = 'slack';\n  note = '';\n}\nreturn [{ json: {\n  ticket_ref: t.ticket_ref, title: t.title, decision, actor, via, note: note || '', channel, ts,\n  where: via === 'portal' ? ' in the portal' : '',\n  ...cardFor(t, decision, via, actor, note, decision === 'approved'),\n} }];"
      },
