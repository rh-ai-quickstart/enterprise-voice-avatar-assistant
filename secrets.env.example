# Keys and settings for the assistant, one file for everything the deployment needs.
# Copy to ~/secrets.env on the bastion host (never into the repository), fill in what you
# have, then: SECRETS_FILE=~/secrets.env NAMESPACE=voice-avatar-assistant scripts/create-secrets.sh
# Every line is optional: leave a value empty to keep that feature off. The README (Setup) explains
# where each value comes from. Passwords for PostgreSQL, the object store, Qdrant, LiveKit and the
# n8n encryption key are generated when absent.

# --- Slack (approvals, notifications) ---------------------------------------------------
# Bot User OAuth Token of the app created from n8n/slack-app-manifest.json (starts with xoxb-)
SLACK_BOT_TOKEN=

# --- Tavus (avatar video) ---------------------------------------------------------------
TAVUS_API_KEY=
# Default face when chart values list no faces (an id like r67d1c9cac37); optional
TAVUS_FACE_ID=
TAVUS_PAL_ID=

# --- Google Docs (transcript archival) --------------------------------------------------
# A Google Cloud service account with the Drive API enabled creates the documents; no OAuth
# consent, no sign-in. Path to its JSON key file on this host (scripts/setup.sh lets you paste
# the key instead and fills this in):
GOOGLE_SERVICE_ACCOUNT_FILE=
# The Drive folder that receives the transcripts (the part of its URL after /folders/),
# shared with the service account's e-mail address (client_email in the key file) as Editor
GOOGLE_DOCS_FOLDER_ID=

# --- n8n owner account (created by the chart; generated when empty) ---------------------
#N8N_OWNER_EMAIL=admin@example.com
#N8N_OWNER_PASSWORD=

# --- Optional providers ------------------------------------------------------------------
SIMLI_API_KEY=
SIMLI_FACE_ID=
# Hugging Face token, only for gated model downloads (the default models need none)
HF_TOKEN=

# --- Remote model endpoints (MaaS), only when models.<x>.deploy is false ----------------
LLM_API_KEY=
STT_API_KEY=
EMBEDDINGS_API_KEY=
GUARDRAILS_API_KEY=

# --- Fixed values instead of generated ones (optional) ----------------------------------
#POSTGRES_PASSWORD=
#S3_SECRET_KEY=
#QDRANT_API_KEY=
#N8N_ENCRYPTION_KEY=
