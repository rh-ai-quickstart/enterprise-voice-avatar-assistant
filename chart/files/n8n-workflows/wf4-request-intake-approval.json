    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body;\nconst t = b.ticket, cls = b.classification || {};\nconst summary = cls.summary || t.description || '';\nconst blocks = [\n  { type: 'header', text: { type: 'plain_text', text: `Service request ${t.ticket_ref}` } },\n  { type: 'section', text: { type: 'mrkdwn', text: `*${t.title}*\\n${summary}` } },\n  { type: 'section', fields: [\n    { type: 'mrkdwn', text: `*Category*\\n${t.category || '-'}` },\n    { type: 'mrkdwn', text: `*Priority*\\n${t.priority || '-'}` },\n    { type: 'mrkdwn', text: `*Requester*\\n${t.requester || '-'}` },\n    { type: 'mrkdwn', text: `*Channel*\\n${b.channel || '-'}` } ] },\n  { type: 'actions', elements: [\n    { type: 'button', style: 'primary', text: { type: 'plain_text', text: 'Approve' }, action_id: 'approve_request', value: t.ticket_ref },\n    { type: 'button', style: 'danger', text: { type: 'plain_text', text: 'Reject' }, action_id: 'reject_request', value: t.ticket_ref } ] }\n];\nreturn [{ json: { ticket_ref: t.ticket_ref, title: t.title, needs_approval: cls.needs_approval !== false, blocks: JSON.stringify({ blocks }), text: `Service request ${t.ticket_ref}: ${t.title}` } }];"
      },
