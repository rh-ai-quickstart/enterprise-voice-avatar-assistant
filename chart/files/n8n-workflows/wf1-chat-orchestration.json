        "responseMode": "responseNode",
        "options": {}
      },
      "id": "386fd6d5-92ca-5719-9dec-1a3bbf6737d3",
      "name": "Chat webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "d2f38379-b943-5276-bc1a-57bf83006b10"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.RAG_API_URL }}/v1/chat",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
